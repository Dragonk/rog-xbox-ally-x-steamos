# Ally Audio — lancuch Dolby na natywnym PipeWire (bez smart-filter, bez EasyEffects).
# Zasoby: ~/ally-dsp-fix (render.conf, lv2/, presety). Nic nie zalezy od Decky.
[Unit]
Description=Ally Audio: lancuch Dolby (PipeWire)
After=pipewire.service wireplumber.service
BindsTo=pipewire.service
ConditionPathExists=/home/deck/ally-dsp-fix/render.conf
ConditionPathExists=/home/deck/ally-dsp-fix/lv2

[Service]
Type=simple
Environment="LV2_PATH=/home/deck/ally-dsp-fix/lv2:/usr/lib/lv2"
Environment=MALLOC_ARENA_MAX=1
ExecStart=/usr/bin/pipewire -c /home/deck/ally-dsp-fix/render.conf
Restart=on-failure
RestartSec=1
LimitMEMLOCK=102400K
Slice=session.slice

[Install]
WantedBy=default.target
