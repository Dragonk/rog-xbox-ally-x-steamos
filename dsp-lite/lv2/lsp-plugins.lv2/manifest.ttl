@prefix lv2:        <http://lv2plug.in/ns/lv2core#> .
@prefix rdfs:       <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ui:         <http://lv2plug.in/ns/extensions/ui#> .
@prefix plug:       <http://lsp-plug.in/plugins/lv2/> .
@prefix plug_ui:    <http://lsp-plug.in/ui/lv2/> .

plug:autogain_stereo
	a lv2:Plugin ;
	lv2:binary <lsp-plugins-lv2.so> ;
	rdfs:seeAlso <autogain_stereo.ttl> .

plug:filter_stereo
	a lv2:Plugin ;
	lv2:binary <lsp-plugins-lv2.so> ;
	rdfs:seeAlso <filter_stereo.ttl> .

plug:limiter_stereo
	a lv2:Plugin ;
	lv2:binary <lsp-plugins-lv2.so> ;
	rdfs:seeAlso <limiter_stereo.ttl> .

plug:mb_compressor_stereo
	a lv2:Plugin ;
	lv2:binary <lsp-plugins-lv2.so> ;
	rdfs:seeAlso <mb_compressor_stereo.ttl> .

plug:para_equalizer_x16_lr
	a lv2:Plugin ;
	lv2:binary <lsp-plugins-lv2.so> ;
	rdfs:seeAlso <para_equalizer_x16_lr.ttl> .
